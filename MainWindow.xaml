<Window x:Class="gVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="gVPN" Width="420" MinWidth="420" MaxWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        Closing="Window_Closing">
    <Window.Resources>
        <sys:String x:Key="LocLaunchApp">Запуск</sys:String>
        <sys:String x:Key="LocDeleteTooltip">Удалить</sys:String>
        <sys:String x:Key="LocRenameTooltip">Переименовать</sys:String>
        <Style x:Key="DarkListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ServerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="#36364f" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2f2f45"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#313244"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#F38BA8"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6C7086"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Border Background="#181825" CornerRadius="12" BorderBrush="#313244" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Заголовок -->
            <Border Grid.Row="0" Background="#181825" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border x:Name="StatusDot" Background="#89B4FA" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHeaderTitle" Text="gVPN" Foreground="#CDD6F4" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="BtnSettings" Content="&#xE713;" Style="{StaticResource WindowControlBtn}" Click="BtnSettings_Click" ToolTip="Настройки"/>
                        <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click" ToolTip="Свернуть в трей"/>
                        <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource WindowCloseBtn}" Click="BtnClose_Click" ToolTip="Скрыть"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Основной экран -->
            <StackPanel x:Name="PnlMainView" Grid.Row="1" Visibility="Visible">
                <Grid Margin="18,4,18,8">
                    <TextBlock x:Name="LblAvailableServers" Text="Доступные серверы" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnPingAll" Content="Ping" Margin="0,0,12,0"
                                Background="Transparent" Foreground="#A6E3A1" BorderThickness="0"
                                FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="BtnPingAll_Click"/>
                        <Button x:Name="BtnToggleAddPanel" Content="+ Добавить"
                                Background="Transparent" Foreground="#89B4FA" BorderThickness="0"
                                FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="BtnToggleAddPanel_Click"/>
                    </StackPanel>
                </Grid>
                <Border Background="#1E1E2E" CornerRadius="8" Margin="16,0,16,10" Padding="6" MaxHeight="220">
                    <ListBox x:Name="LstServers"
                             Style="{StaticResource DarkListBoxStyle}"
                             ItemContainerStyle="{StaticResource ServerItemStyle}"
                             SelectionChanged="LstServers_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#CDD6F4"
                                               FontSize="13" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Foreground="{Binding LatencyColor}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Border Grid.Column="2" Background="#313244" CornerRadius="4" Padding="6,2" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" Foreground="#89B4FA" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Button Grid.Column="3" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="22" Height="22"
                                            Background="Transparent" Foreground="#6C7086" BorderThickness="0" Cursor="Hand"
                                            Click="BtnRenameServer_Click" ToolTip="{DynamicResource LocRenameTooltip}"/>
                                    <Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="22" Height="22"
                                            Background="Transparent" Foreground="#6C7086" BorderThickness="0" Cursor="Hand"
                                            Click="BtnDeleteServer_Click" ToolTip="{DynamicResource LocDeleteTooltip}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Панель переименования -->
                <Border x:Name="PnlRenameServer" Margin="16,0,16,12" Background="#1E1E2E" CornerRadius="8" Padding="10" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRename" Grid.Column="0" Height="30" Background="#181825" Foreground="#CDD6F4"
                                 BorderBrush="#313244" BorderThickness="1" Padding="8,4" FontSize="12" VerticalContentAlignment="Center"
                                 KeyDown="TxtRename_KeyDown"/>
                        <Button x:Name="BtnSaveRename" Grid.Column="1" Content="OK" Height="30" Padding="12,0" Margin="8,0,0,0"
                                Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                BorderThickness="0" Cursor="Hand" Click="BtnSaveRename_Click"/>
                        <Button x:Name="BtnCancelRename" Grid.Column="2" Content="✕" Height="30" Width="30" Margin="6,0,0,0"
                                Background="#313244" Foreground="#CDD6F4" FontSize="12"
                                BorderThickness="0" Cursor="Hand" Click="BtnCancelRename_Click"/>
                    </Grid>
                </Border>

                <!-- Панель добавления -->
                <Border x:Name="PnlAddServer" Margin="16,0,16,12" Background="#1E1E2E" CornerRadius="8" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LblAddHint" Text="Вставьте vless://, trojan://, ss://, URL подписки или WG конфиг:" Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtInput" Height="65" Background="#181825" Foreground="#CDD6F4"
                                 BorderBrush="#313244" BorderThickness="1" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Padding="8" FontSize="12"/>
                        <Button x:Name="BtnAdd" Content="Сохранить подключение" Height="32" Margin="0,8,0,0"
                                Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
                    </StackPanel>
                </Border>

                <!-- Статус и скорость -->
                <StackPanel Margin="0,4,0,12" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Статус: Отключено" Foreground="#BAC2DE" HorizontalAlignment="Center" FontSize="13"/>
                    <StackPanel x:Name="PnlSpeed" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtDownloadSpeed" Text="↓ 0.00 MB/s" Foreground="#A6E3A1" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TxtUploadSpeed" Text="↑ 0.00 MB/s" Foreground="#89B4FA" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопка подключения -->
                <Button x:Name="BtnConnect" Content="Подключить" Height="46" Margin="16,0,16,16"
                        Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="15"
                        BorderThickness="0" Cursor="Hand" Click="BtnConnect_Click"/>
            </StackPanel>

            <!-- 3. Экран настроек -->
            <StackPanel x:Name="PnlSettingsView" Grid.Row="1" Margin="20,10,20,20" Visibility="Collapsed">
                <TextBlock x:Name="LblGeneralSettings" Text="Основные настройки" Foreground="#A6ADC8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <Border Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblLanguage" Text="Язык интерфейса" Foreground="#CDD6F4" FontSize="13" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="1" Height="28" Background="#181825" Foreground="#CDD6F4"
                                  BorderBrush="#313244" SelectionChanged="CmbLanguage_SelectionChanged">
                            <ComboBoxItem Content="Русский" Tag="ru"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Polski" Tag="pl"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Background="#1E1E2E" CornerRadius="8" Padding="14,14,14,6" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="ChkAutoStartApp" Content="Запускать gVPN вместе с Windows"
                                  Style="{StaticResource DarkCheckBoxStyle}" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                        <CheckBox x:Name="ChkAutoStartConnect" Content="Автоматически подключать выбранный сервер"
                                  Style="{StaticResource DarkCheckBoxStyle}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        <CheckBox x:Name="ChkStartMinimized" Content="Запускать свёрнутым в трей"
                                  Style="{StaticResource DarkCheckBoxStyle}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E2E" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="LblRoutingTitle" Text="Режим маршрутизации трафика" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <RadioButton x:Name="RbTunnelAll" Content="Весь трафик ПК (Глобальный VPN)" Foreground="#CDD6F4" FontSize="12" IsChecked="True" Margin="0,0,0,8" GroupName="RoutingMode" Checked="OnRoutingModeChanged"/>
                        <RadioButton x:Name="RbTunnelApps" Content="Только выбранные приложения" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,10" GroupName="RoutingMode" Checked="OnRoutingModeChanged"/>
                        <StackPanel x:Name="PnlAppsList" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock x:Name="LblSelectedApps" Text="Выбранные приложения (.exe):" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                <Button x:Name="BtnAddApp" Content="+ Добавить .exe" HorizontalAlignment="Right"
                                        Background="#313244" Foreground="#89B4FA" BorderThickness="0"
                                        FontSize="11" Padding="8,3" Cursor="Hand" Click="BtnAddApp_Click"/>
                            </Grid>
                            <Border Background="#181825" CornerRadius="6" Padding="4" MaxHeight="100">
                                <ListBox x:Name="LstApps" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Content="{DynamicResource LocLaunchApp}" Margin="6,0,4,0" Padding="6,1"
                                                        Background="#313244" Foreground="#A6E3A1" FontSize="10" BorderThickness="0"
                                                        Cursor="Hand" Click="BtnLaunchApp_Click"/>
                                                <Button Grid.Column="2" Content="✕" Width="18" Height="18" Background="Transparent"
                                                        Foreground="#F38BA8" FontSize="10" BorderThickness="0" Cursor="Hand" Click="BtnRemoveApp_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnBackToServers" Content="Назад к серверам" Height="40"
                        Background="#313244" Foreground="#CDD6F4" FontWeight="SemiBold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Click="BtnBackToServers_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>